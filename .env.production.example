PORT=3000
APP_ENV=production

# Database
DB_SERVER=YOUR_DB_SERVER
DB_PORT=1433
DB_DATABASE=YOUR_DB_DATABASE
DB_USER=YOUR_DB_USER
DB_PASSWORD=YOUR_DB_PASSWORD
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true
DB_POOL_MAX=10
DB_POOL_MIN=0
DB_POOL_IDLE_TIMEOUT=30000

# HONAI single-session policy
# Idle timeout: sesi dianggap tidak aktif setelah tidak ada request selama N menit.
HONAI_SESSION_IDLE_MINUTES=30
# Hard timeout: sesi wajib login ulang setelah N jam walaupun masih aktif.
HONAI_SESSION_ABSOLUTE_HOURS=12
# Security Pass 2: true = semua endpoint /api wajib session kecuali allowlist publik.
HONAI_STRICT_SESSION=true

# Backblaze B2 / S3 compatible storage
B2_ENDPOINT=https://YOUR_ENDPOINT
B2_KEY_ID=YOUR_B2_KEY_ID
B2_BUCKET_NAME=YOUR_BUCKET
B2_APPLICATION_KEY=YOUR_B2_APPLICATION_KEY
B2_PUBLIC_URL=

# WhatsApp / Meta
WA_ACCESS_TOKEN=YOUR_WA_ACCESS_TOKEN
WA_API_VERSION=v25.0
WA_PHONE_NUMBER_ID=YOUR_PHONE_NUMBER_ID
WA_NOTIFICATION_TEMPLATE=hello_world
WA_NOTIFICATION_TEMPLATE_LANGUAGE=en_US

# Security Pass 3 - HTTP / CORS / rate limit / upload hardening
# Origin web production yang boleh memanggil API dari browser. Pisahkan dengan koma.
HONAI_ALLOWED_ORIGINS=https://honai.bankanp.com
# Hanya untuk emergency/debug; production sebaiknya false.
HONAI_CORS_ALLOW_ALL=false
# Jika Flutter Web dijalankan dari localhost dan tetap memakai API production,
# aktifkan sementara lalu kembalikan false setelah testing.
HONAI_ALLOW_LOCALHOST_ORIGIN=false

# Proteksi brute-force dan request burst (in-memory per instance Railway).
HONAI_LOGIN_RATE_WINDOW_MIN=15
HONAI_LOGIN_RATE_MAX=12
HONAI_API_RATE_WINDOW_MIN=1
HONAI_API_RATE_MAX=600
HONAI_UPLOAD_RATE_WINDOW_MIN=10
HONAI_UPLOAD_RATE_MAX=40

# JSON bukan jalur upload file. Upload file menggunakan multipart/form-data.
HONAI_JSON_BODY_LIMIT=5mb

# Batas total multipart request yang dipakai uploader utama.
HONAI_UPLOAD_TOTAL_MB=60
